# Exemplo de configuração .wslconfig
# Salvar como: %USERPROFILE%\.wslconfig

[wsl2]
# Habilita compactação automática (requer WSL 2.0.0+)
sparseVhd=true

# Configurações de performance
memory=4GB
processors=4
swap=2GB
swapFile=%TEMP%\wsl-swap.vhdx

# Configurações de rede
localhostForwarding=true

# Configurações de kernel
debugConsole=false
